// The Teams app manifest, with placeholders that `build-package.mts` fills in:
// <TEAMS_APP_ID>   the Teams app's own id, a GUID you generate once and keep forever
// <BOT_CLIENT_ID>  the bot's app registration (client) id
// <WEB_URL>        origin of the web app, no trailing slash
// <WEB_DOMAIN>     host of the web app, derived from WEB_URL
// <VERSION>        filled in per build
{
	"$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
	"manifestVersion": "1.24",
	"version": "<VERSION>",
	"id": "<TEAMS_APP_ID>",
	"developer": {
		"name": "Marvin Brouwer",
		"websiteUrl": "<WEB_URL>/",
		"privacyUrl": "<WEB_URL>/privacy/",
		"termsOfUseUrl": "<WEB_URL>/terms/"
	},
	"name": {
		"short": "TVote",
		"full": "TVote: scrum voting, but simple"
	},
	"description": {
		"short": "Scrum voting, but simple",
		"full": "Every planning poker tool does too much. TVote asks the meeting for an estimate, everyone votes right on the card in the chat, and the card turns into the result. Votes live in memory for as long as the vote runs, nothing is stored."
	},
	"accentColor": "#5B5FC7",
	"icons": {
		"color": "color.png",
		"outline": "outline.png"
	},
	// Only so TVote can be added to a meeting: Teams lists an app under a meeting's Apps, and adds it to the meeting chat
	// with its bot, only when it has something for meetings. The panel itself explains how to start an estimate.
	"configurableTabs": [
		{
			"configurationUrl": "<WEB_URL>/teams/configure/",
			"canUpdateConfiguration": false,
			"scopes": ["groupChat"],
			"context": ["meetingSidePanel", "meetingChatTab", "meetingDetailsTab"]
		}
	],
	// The bot posts the start card and the vote cards, and handles every click on them. In meetings (group chats) and
	// in its own chat. Channels can come back later.
	"bots": [
		{
			"botId": "<BOT_CLIENT_ID>",
			"scopes": ["groupChat", "personal"],
			"supportsFiles": false,
			"supportsCalling": false,
			"supportsVideo": false,
			"isNotificationOnly": false,
			"commandLists": [
				{
					"scopes": ["groupChat", "personal"],
					"commands": [
						{
							"title": "start",
							"description": "Posts the card to start an estimate"
						}
					]
				}
			]
		}
	],
	"validDomains": ["<WEB_DOMAIN>"]
}

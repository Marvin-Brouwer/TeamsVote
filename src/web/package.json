    "@rooted/components": "1.0.0-alpha.24",
    "@rooted/markdown": "1.0.0-alpha.12",
    "@rooted/pwa": "1.0.0-alpha.5",
    "@rooted/router": "1.0.0-alpha.31",
    "@rooted/store": "1.0.0-alpha.12"
  },
  "devDependencies": {
    "@rooted-adapters/azure-static-webapp": "1.0.0-alpha.28",
    "@rooted/application": "1.0.0-alpha.41",
    "@rooted/seo": "1.0.0-alpha.19",

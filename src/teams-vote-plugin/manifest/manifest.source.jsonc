{
    "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "1.0",
    "id": "<TEAMS_APP_ID>",
    "developer": {
        "name": "Marvin Brouwer",
        "websiteUrl": "https://github.com/Marvin-Brouwer/TeamsVote",
        "privacyUrl": "https://github.com/Marvin-Brouwer/TeamsVote/blob/main/doc/privacy-policy.md",
        "termsOfUseUrl": "https://github.com/Marvin-Brouwer/TeamsVote/blob/main/doc/tos.md"
    },
    "name": {
        "short": "TVote",
        "full": "Scrum voting, but simple"
    },
    "description": {
        "short": "Scrum voting, but simple",
        "full": "Every scrum voting website or teams plugin does too much. \nThis app just requests estimates from team members and collects the total."
    },
    "accentColor": "#6466af",
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "webApplicationInfo": {
        "id": "<TEAMS_APP_CLIENT_ID>",
        // https://stackoverflow.com/a/72171127/2319865 doesn't seem to fix it :(
        "resource": "api://<TEAMS_APP_CLIENT_ID>",
        // Adding this added the correct permissions when uploading to teams, seems to be required
        "nestedAppAuthInfo": [
            {
                "redirectUri": "<TEAMS_UI_URL>/teams/auth_return.html",
                "scopes": [
                    "tab"
                ]
            }
        ]
    },
    // "configurableTabs": [
    //     {
    //         "configurationUrl": "<TEAMS_UI_URL>/teams/tab/",
    //         "id": "t-vote-tab",
    //         "canUpdateConfiguration": false,
    //         "meetingSurfaces": [
    //             "sidePanel",
    //             "stage"
    //         ],
    //         "context": ["channelTab","meetingChatTab","privateChatTab","meetingDetailsTab","meetingSidePanel", "meetingStage"],
    //         "supportedSharePointHosts": [],
    //         "scopes": [
    //             "groupChat",
    //             "team"
    //         ],
    //         "sharePointPreviewImage": "color.png"
    //     }
    // ],
    "validDomains": [
        "marvin-brouwer.github.io",
        "login.microsoftonline.com",
        "teams.microsoft.com"
    ],
    "bots": [
        {
            "botId": "<TEAMS_CHATBOT_CLIENT_ID>",
            "scopes": [
                "groupChat",
                "team",
                "personal"
            ],
            "supportsCalling": false,
            "supportsVideo": false,
            "supportsFiles": false,
            // Make the bot addressable, because of staticTab.contentBotId
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "groupChat",
                        "team",
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "Help",
                            "description": "Displays this help message"
                        }
                    ]
                }
            ]
        }
    ],
    "authorization": {
        "permissions": {
            "resourceSpecific": [
                {
                    "name": "ChatMessageReadReceipt.Read.Chat",
                    "type": "Application"
                }
            ]
        }
    }
}
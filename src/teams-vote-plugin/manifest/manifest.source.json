{
    "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.23/MicrosoftTeams.schema.json",
    "manifestVersion": "1.23",
    "version": "1.0.0",
    "id": "<TEAMS_APP_ID>",
    "developer": {
        "name": "Marvin Brouwer",
        "websiteUrl": "https://github.com/Marvin-Brouwer/TeamsVote",
        "privacyUrl": "https://github.com/Marvin-Brouwer/TeamsVote/blob/main/doc/privacy-policy.md",
        "termsOfUseUrl": "https://github.com/Marvin-Brouwer/TeamsVote/blob/main/doc/tos.md"
    },
    "name": {
        "short": "TeamsVote",
        "full": "Scrum voting, but simple"
    },
    "description": {
        "short": "Scrum voting, but simple",
        "full": "Every scrum voting website or teams plugin does too much. \nThis app just requests estimates from team members and collects the total."
    },
    "accentColor": "#6466af",
    "icons": {
        "color": "./color.png",
        "outline": "./outline.png"
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "webApplicationInfo": {
        "id": "<TEAMS_APP_CLIENT_ID>",
        "resource": "<TEAMS_APP_CLIENT_ID_URL>"
    },
    "staticTabs": [
        {
            "entityId": "teamsVoteTab",
            "name": "Vote",
            "contentUrl": "<TEAMS_UI_URL>",
            "scopes": [
                "team",
                "groupChat"
            ]
        }
    ],
    "validDomains": [
        "marvin-brouwer.github.io"
    ],
    "bots": [
        {
            "botId": "<TEAMS_CHATBOT_CLIENT_ID>",
            "scopes": [
                "team",
                "groupChat"
            ],
            "supportsCalling": false,
            "supportsVideo": false,
            "supportsFiles": false,
            "isNotificationOnly": false
        }
    ],
    "composeExtensions": [
        {
            "botId": "<TEAMS_CHATBOT_CLIENT_ID>",
            "commands": [
                {
                    "id": "vote",
                    "type": "action",
                    "title": "Vote",
                    "description": "Start a new voting session"
                }
            ]
        }
    ]
}